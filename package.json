{
  "name": "beanydrive",
  "productName": "BeanyDrive",
  "version": "2.1.2",
  "description": "GreenyBeany's desktop client for Discord-backed cloud storage",
  "main": "main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.greenybeany.beanydrive",
    "productName": "BeanyDrive",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "discord-client.js",
      "core/**/*",
      "platform/**/*",
      "drive-config.js",
      "util.js",
      "icon.png",
      "renderer/**/*",
      "docs/legal/**/*",
      "update-checker.js",
      "upload-resume.js",
      "upload-stats.js",
      "drag-cache.js"
    ],
    "icon": "icon.png",
    "publish": {
      "provider": "github",
      "owner": "greenythebeany",
      "repo": "BeanyDrive"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon-mac.png",
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "afterPack": "tools/mac-adhoc-sign.js",
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
