{
  "name": "beanydrive",
  "productName": "BeanyDrive",
  "version": "1.0.3",
  "description": "GreenyBeany's terminal-styled desktop client for Discord-backed cloud storage",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.greenybeany.beanydrive",
    "productName": "BeanyDrive",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "discord-client.js",
      "drive-config.js",
      "util.js",
      "icon.png",
      "renderer/**/*",
      "update-checker.js",
      "upload-resume.js",
      "upload-stats.js",
      "drag-cache.js"
    ],
    "icon": "icon.png",
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
